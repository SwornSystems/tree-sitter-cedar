// https://docs.renovatebot.com/configuration-options
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "dependencyDashboard": true,
  "enabledManagers": ["npm", "github-actions", "nix"],

  // https://docs.renovatebot.com/modules/manager/npm
  "npm": {
    "enabled": true
  },

  // https://docs.renovatebot.com/modules/manager/github-actions
  "github-actions": {
    "enabled": true
  },

  // https://docs.renovatebot.com/modules/manager/nix
  "nix": {
    "enabled": true
  },

  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["playwright"],
      "enabled": false
    }
  ],

  "lockFileMaintenance": {
    "enabled": true
  },

  "vulnerabilityAlerts": {
    "enabled": false
  }
}
